@import "./_variables.styl"
/*slide start*/
main
  margin-top 50px

.blog-slide-wrap
  position sticky
  top 20px
  box-sizing border-box
  display flex
  flex-direction column
  align-items center
  gap 20px
  width 100%
  max-width 300px
  height 350px
  padding 20px
  background-color card-color
  border 1px solid border-color
  border-radius 10px
  color text-color

.blog-slide__avatar img
  width 80px
  height 80px
  overflow hidden
  border-radius 50%

.blog-slide__name
  font-size 30px
  text-align center

.blog-slide__state
  display flex
  justify-content center
  .blog-slide__state--item
    padding 0 10px
    a
      display flex
      flex-direction column
      align-items center
      gap 2px
      text-decoration none
      color text-color
      
.blog-slide__state > :first-child
  border-right 2px solid border-color
  
.blog-slide__content
  font-size 20px
  text-indent 2em
  line-height 30px
    
.blog-slide__info
  display flex
  flex-direction column
  align-items center
  gap 15px
/*slide end*/
