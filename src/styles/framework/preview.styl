@import "./_variables.styl"
/*preview start*/
.blog-article-preview
  height 60vh
  min-height 320px
  padding 20px
  border 1px solid border-color
  border-radius 10px
  background-color card-color
  & h1
    height 20px
    text-align center
    line-height 20px
    font-size 28px
    color title-color
  & button
    width 100px
    height 40px
    background-color but-color
    color title-color
    border 1px solid border-color
    border-radius 10px

.blog-article-preview__content
  margin-top 15px
  color text-color
  
/*preview end*/