<article class="blog-article__item">
  <div class="blog-article__item--img">
    <img src="{{imageSrc}}" alt="" width="1080" height="1080">
  </div>
  <div class="blog-article__item--content">
    <div class="blog-article__item--title">
      <h1>{{title}}</h1>
    </div>
    <div class="blog-article__item--desc">
      <p>{{content}}</p>
    </div>
    <div class="blog-article__item--footer">
      <time datetime="2026-10-31"><i class="bi bi-clock" aria-hidden="true"></i> {{time}}</time>
      <div class="blog-article__item--actions">
        <button type="button"><i class="bi bi-hand-thumbs-up" aria-hidden="true"></i> 点赞
          <span>{{likeNum}}</span></button>
        <button type="button"><i class="bi bi-chat-dots" aria-hidden="true"></i> 评论 <span>{{commentNum}}</span></button>
      </div>
    </div>
  </div>
</article>