/*header start*/
.blog-header 
  display: grid
  grid-template-columns: 1fr 4fr 3fr 2fr
  box-sizing: border-box
  height: 100px
  padding: 20px
  background-color: #18191B
  border-bottom: 1px solid #363A3F
  align-items: center


.logo 
  margin-left: 50px


.logo img 
  display: inline-block
  width: 60px
  height: auto
  overflow: hidden
  border-radius: 50%
  vertical-align: middle


.blog-header__nav ul 
  width: 100%
  display: grid
  grid-template-columns: repeat(6, 1fr)
  text-align: center


.blog-header__nav li a 
  font-size: 20px
  color: #B0B4BA
  text-decoration: none
  line-height: 60px


.blog-header__search 
  position: relative
  width: 80%
  margin-left: 20px


.blog-header__search--inp 
  box-sizing: border-box
  width: 100%
  min-width: 0
  height: 44px
  padding: 0 14px
  background-color: #212225
  color: #EDEEF0
  border: 1px solid #363A3F
  border-radius: 8px
  font-size: 16px
  transition: border-color 0.2s, box-shadow 0.2s


.blog-header__search--inp::placeholder 
  color: #B0B4BA
  opacity: 1


.blog-header__search--inp:focus 
  background-color: #212225
  color: #EDEEF0
  border-color: #70B8FF
  outline: none
  box-shadow: 0 0 0 1px #70B8FF


.blog-header__search--but 
  position: absolute
  right: 5px
  top: 50%
  transform: translateY(-50%)
  color: #B0B4BA
  cursor: pointer


.blog-header__lr--login,
.blog-header__lr--regist 
  display: inline-block
  width: 80px
  height: 40px
  background-color: #70B8FF
  text-align: center
  line-height: 40px
  border-radius: 5px
  font-size: 18px
  font-weight: 500
  color: #111113
  margin-right: 5px
  cursor: pointer
  user-select: none
  transition: .2s linear


.blog-header__lr--regist 
  margin-right: 0


.blog-header__lr--login:hover,
.blog-header__lr--regist:hover 
  background-color: #8FC8FF
  transform: scale(1.02)


.blog-header__moblieList--icon 
  grid-column: 4/5
  font-size: 30px
  color: #B0B4BA
  cursor: pointer
  justify-self: self-end
/*header end*/ 